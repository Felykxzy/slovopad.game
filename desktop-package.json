{
  "name": "slovopad",
  "productName": "СЛОВОПАД",
  "version": "2.4.0",
  "description": "Аркадная игра на скорость печати",
  "author": "Felykxzy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.felykxzy.slovopad",
    "productName": "СЛОВОПАД",
    "icon": "game/icon-512.png",
    "files": [
      "main.js",
      "game/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/installer-icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "Slovopad-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "Slovopad-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Felykxzy",
        "repo": "slovopad.game"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "СЛОВОПАД",
      "runAfterFinish": true,
      "language": "1049",
      "installerIcon": "build/installer-icon.ico",
      "uninstallerIcon": "build/installer-icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "artifactName": "Slovopad-Setup-${version}.${ext}"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 110,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 210,
          "type": "file"
        },
        {
          "x": 400,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
